PORT=3000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=<long random string>
# Code users must enter to self-register (replaces the old hardcoded admin auth code)
REGISTER_CODE=<registration code>
CLOUDINARY_CLOUD_NAME=dj181g1it
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Comma-separated list of allowed frontend origins
FRONTEND_ORIGINS=http://localhost:3001,https://your-frontend.vercel.app
# Cache (optional). Use ONE of these; without them an in-process memory cache is used.
# With a single API instance the memory cache is the fastest option (no network round-trips);
# Redis only pays off when several instances must share one cache.
# REDIS_URL=redis://red-xxxx:6379            (Render Key Value / any Redis, lowest latency)
# UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=
# Used by `npm run seed` to create/update the single admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<strong password>
